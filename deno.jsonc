{
  "license": "Apache-2.0",
  "version": "0.0.1",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^19.1.1"
  },
  "fmt": {
    "exclude": [
      "node_modules/",
      "LICENSE",
      "**/*.md",
      "**/*.mdc",
      "**/*.ipynb",
      ".claude/",
      ".cargo/",
      "target/",
      "**/coverage/**",
      "**/dist/**",
      "packages/docs/public/**"
    ]
  },
  "exclude": [
    "**/node_modules/**",
    "dist/**",
    "node_modules/**",
    ".tanstack/**",
    ".vite/deps/**",
    ".vite/**",
    "**/routeTree.gen.ts",
    "**/.venv/**",
    "**/target/**",
    "**/__pycache__/**",
    "**/.DS_Store",
    "**/coverage/**"
  ],
  "workspace": [
    "packages/*"
  ]
}
