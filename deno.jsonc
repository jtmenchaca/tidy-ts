{
  "license": "Apache-2.0",
  "version": "0.0.1",
  "exports": "./src/mod.ts",
  "imports": {
    "@tests/shims": "./tests/shims/test.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^19.1.1"
  },
  "fmt": {
    "exclude": [
      "node_modules/",
      "LICENSE",
      "**/*.md",
      "**/*.mdc",
      "**/*.ipynb",
      ".claude/",
      ".cargo/",
      "target/",
      "vendor/",
      "z-other/"
    ]
  },
  "exclude": [
    "node_modules",
    "vendor",
    "z-other",
    "sources",
    "examples/docs-tests",
    "sources/**",
    ".cargo/",
    "target/",
    "docs/",
    "docs/**",
    "tidy-stats/",
    "src/tidy-stats/rust",
    "tests/tidy-stats/__pycache__",
    "tests/tidy-stats/.venv",
    "docs/src/routeTree.gen.ts",
    "tmp/",
    "blank-mcp/",
    "tests/runtimes/"
  ],
  "workspace": [
    "src/dataframe",
    "src/ai",
    "src/shims",
    "src/mcp",
    "examples/dataframe"
  ]
}
