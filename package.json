{
  "name": "tidy-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:dataframe": "deno run -A scripts/parse-check.ts --unstable-tsgo packages/dataframe",
    "check:graph": "deno run -A scripts/parse-check.ts --unstable-tsgo packages/graph",
    "check:mcp": "deno run -A scripts/parse-check.ts --unstable-tsgo packages/mcp",
    "check:shims": "deno run -A scripts/parse-check.ts --unstable-tsgo packages/shims",
    "benchmark:runner": "cd packages/testing/benchmarks && deno run -A runner.ts && cd ../..",
    "test:dataframe": "deno run -A scripts/parse-test.ts -A --v8-flags=--max-old-space-size=8192 --parallel packages/dataframe",
    "test:graph": "deno run -A scripts/parse-test.ts -A --parallel packages/graph",
    "test:examples": "deno test -A --v8-flags=--max-old-space-size=8192 --parallel packages/examples",
    "test:examples:bun": "bun test packages/examples/dataframe",
    "test:examples:node": "sh -c 'npx tsx packages/examples/dataframe/*.test.ts'",
    "test:statistical-tests": "deno run -A scripts/parse-test.ts -A --parallel packages/testing/statistical_tests/",
    "test:distributions": "deno run -A scripts/parse-test.ts -A --parallel packages/testing/distributions/",
    "test:glm": "deno run -A scripts/parse-test.ts -A --v8-flags=--max-old-space-size=8192 --parallel packages/testing/glm/",
    "test:gee": "deno run -A scripts/parse-test.ts -A --v8-flags=--max-old-space-size=8192 --parallel packages/testing/gee/",
    "test:stats": "pnpm test:distributions && pnpm test:statistical-tests && pnpm test:glm",
    "test:runtimes": "cd packages/testing/runtimes && bash test-runner.sh",
    "wasmbuild": "deno run -A scripts/parse-build.ts Building WASM -- deno run -A jsr:@deno/wasmbuild@0.21.1 --features wasm --out packages/dataframe/lib",
    "napibuild": "deno run -A scripts/parse-build.ts Building native addon -- sh -c 'cargo build --features napi-rs --release && cp target/release/libtidy_ts_dataframe.dylib packages/dataframe/lib/tidy_ts_dataframe.darwin-arm64.node && cp target/release/libtidy_ts_dataframe.dylib packages/npm-darwin-arm64/tidy_ts_dataframe.darwin-arm64.node'",
    "napibuild:win32-x64": "deno run -A scripts/parse-build.ts Building native addon [win32-x64] -- sh -c 'cargo xwin build --features napi-rs --release --target x86_64-pc-windows-msvc && cp target/x86_64-pc-windows-msvc/release/tidy_ts_dataframe.dll packages/npm-win32-x64/tidy_ts_dataframe.win32-x64.node'",
    "build:npm:shims": "deno run -A scripts/build-shims-npm.ts",
    "build:npm:dataframe": "deno run -A scripts/build-dataframe-npm.ts",
    "build:npm:graph": "deno run -A scripts/build-graph-npm.ts",
    "build:npm": "pnpm build:npm:shims && pnpm build:npm:dataframe && pnpm build:npm:graph",
    "publish:shims:npm": "cd packages/shims/dist && pnpm publish --access public --no-git-checks",
    "publish:dataframe:npm": "cd packages/dataframe/dist && pnpm publish --access public --no-git-checks",
    "publish:graph:npm": "cd packages/graph/dist && pnpm publish --access public --no-git-checks",
    "publish:dataframe:npm:darwin-arm64": "cp packages/dataframe/lib/tidy_ts_dataframe.darwin-arm64.node packages/npm-darwin-arm64/ && cd packages/npm-darwin-arm64 && pnpm publish --access public --no-git-checks",
    "publish:dataframe:npm:win32-x64": "cd packages/npm-win32-x64 && pnpm publish --access public --no-git-checks",
    "publish:all:npm": "pnpm publish:shims:npm && pnpm publish:dataframe:npm:darwin-arm64 && pnpm publish:dataframe:npm:win32-x64 && pnpm publish:dataframe:npm && pnpm publish:graph:npm",
    "bump": "deno run -A scripts/bump-version.ts",
    "intellisense": "npx tsx scripts/intellisense.ts"
  },
  "dependencies": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0.21.1",
    "@hookform/resolvers": "^4.1.2",
    "@libsql/client": "^0.15.15",
    "@openai/agents": "0.11.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@shikijs/langs": "^3.12.2",
    "@shikijs/themes": "^3.12.2",
    "@shikijs/transformers": "^3.12.0",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/expect": "jsr:@std/expect@^1.0.15",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "@std/random": "jsr:@std/random@^0.1.2",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-query": "^5.67.0",
    "@tanstack/react-router": "^1.157.18",
    "@tanstack/react-router-devtools": "^1.157.18",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router-cli": "^1.157.18",
    "@tanstack/router-plugin": "^1.157.18",
    "@tidy-ts/dataframe": "workspace:*",
    "@tidy-ts/dataframe-darwin-arm64": "workspace:*",
    "@tidy-ts/dataframe-win32-x64": "workspace:*",
    "@tidy-ts/graph": "workspace:*",
    "@tidy-ts/shims": "workspace:*",
    "@tmcp/adapter-valibot": "^0.1.4",
    "@tmcp/transport-stdio": "^0.3.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@uwdata/flechette": "^2.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "arquero": "^8.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.5.2",
    "esbuild": "^0.25.10",
    "hyparquet": "^1.23.2",
    "hyparquet-compressors": "^1.1.1",
    "hyparquet-writer": "^0.11.2",
    "lucide-react": "^0.476.0",
    "next-themes": "^0.4.4",
    "openai": "^6.36.0",
    "playwright": "^1.54.1",
    "react": "^19.1.1",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-vega": "^8.0.0",
    "recharts": "^3.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.12.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "tailwindcss-animate": "^1.0.7",
    "tmcp": "^1.13.0",
    "valibot": "^1.1.0",
    "vaul": "^1.1.2",
    "vega": "^6.2.0",
    "vega-embed": "^7.0.2",
    "vega-lite": "^6.4.1",
    "vite": "^7.0.4",
    "zod": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/router-generator>zod": "^3.24.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^22.11.18",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2"
  }
}
