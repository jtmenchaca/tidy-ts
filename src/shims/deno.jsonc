{
  "name": "@tidy-ts/shims",
  "version": "0.0.18",
  "exports": "./mod.ts",
  "license": "MIT",
  "imports": {
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/expect": "jsr:@std/expect@^1.0.15"
  },
  "tasks": {
    "generateKey": "deno run encryption/generateKey.ts",
    "generateKey:install": "deno install --global -A --import-map ../../import_map.json --name generate-key --force encryption/generateKey.ts"
  }
}
