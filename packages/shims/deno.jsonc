{
  "name": "@tidy-ts/shims",
  "version": "1.4.0",
  "exports": {
    ".": "./mod.ts",
    "./detect": "./detect.ts",
    "./result": "./result.ts",
    "./errors": "./errors.ts",
    "./async": "./async.ts",
    "./fetch": "./fetch.ts",
    "./encryption": "./encryption/mod.ts"
  },
  "license": "MIT",
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.15"
  },
  "tasks": {
    "generateKey": "deno run encryption/generateKey.ts",
    "generateKey:install": "deno install --global -A --config deno.jsonc --name generate-key --force encryption/generateKey.ts"
  }
}
